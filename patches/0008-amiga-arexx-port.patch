+#ifdef __AMIGA__
+#include <wx/openlayout/arexx.h>
+#include "cbplugin.h"
+
+// AmigaOS: the ARexx port CODEBLOCKS.1, on the GFOpenWX Toolkit's
+// wxARexxPort and arexx.class, with the toolkit's QUIT, ACTIVATE,
+// DEACTIVATE, VERSION, HELP and FAULT:
+//   OPEN FILE/A            a file, project or workspace, as File > Open
+//   SAVEALL                every file and project
+//   BUILD, REBUILD, CLEAN, RUN  TARGET,WAIT/S
+//                          the active project (its active target, or
+//                          TARGET); WAIT answers once it has finished: RC 10
+//                          and RC2 the exit code when that is not 0
+//   STOP                   stop the build or the program
+//   BUSY                   RESULT: 1 while building or running, else 0
+static void AmigaRexxStart(MainFrame* frame)
+{
+    static const long kWait = 3600000; // an hour at most
+    wxARexxPort* rexx = new wxARexxPort("CODEBLOCKS", "Code::Blocks " + appglobals::AppVersion);
+    auto compiler = [](wxARexxCommand& c) -> cbCompilerPlugin* {
+        cbCompilerPlugin* cp = Manager::IsAppShuttingDown() ? nullptr
+                               : Manager::Get()->GetPluginManager()->GetFirstCompiler();
+        if (!cp)
+            c.SetError(20);
+        return cp;
+    };
+    auto build = [rexx, compiler](wxARexxCommand& c, int (cbCompilerPlugin::*byTarget)(ProjectBuildTarget*),
+                                  int (cbCompilerPlugin::*byName)(const wxString&)) {
+        cbCompilerPlugin* cp = compiler(c);
+        if (!cp)
+            return;
+        if (cp->IsRunning() || !Manager::Get()->GetProjectManager()->GetActiveProject())
+        {
+            c.SetError(10);
+            return;
+        }
+        int r = c.Has(0) ? (cp->*byName)(c.Str(0)) : (cp->*byTarget)(nullptr);
+        if (r != 0)
+        {
+            c.SetError(10, r);
+            return;
+        }
+        if (c.Switch(1) && rexx->WaitFor(c, [cp]() {
+                return Manager::IsAppShuttingDown() || !cp->IsRunning();
+            }, kWait))
+        {
+            if (cp->GetExitCode() != 0)
+                c.SetError(10, cp->GetExitCode());
+        }
+    };
+    rexx->Add("OPEN", "FILE/A", [frame](wxARexxCommand& c) {
+        wxString file = c.Str(0);
+        if (!wxFileExists(file))
+            c.SetError(10, 205);    // object not found
+        else if (!frame->Open(file))
+            c.SetError(10);
+    });
+    rexx->Add("SAVEALL", "", [](wxARexxCommand& c) {
+        if (Manager::IsAppShuttingDown())
+            c.SetError(20);
+        else if (!Manager::Get()->GetEditorManager()->SaveAll() ||
+                 !Manager::Get()->GetProjectManager()->SaveAllProjects())
+            c.SetError(5);
+    });
+    rexx->Add("BUILD", "TARGET,WAIT/S", [build](wxARexxCommand& c) {
+        build(c, &cbCompilerPlugin::Build, &cbCompilerPlugin::Build);
+    });
+    rexx->Add("REBUILD", "TARGET,WAIT/S", [build](wxARexxCommand& c) {
+        build(c, &cbCompilerPlugin::Rebuild, &cbCompilerPlugin::Rebuild);
+    });
+    rexx->Add("CLEAN", "TARGET,WAIT/S", [build](wxARexxCommand& c) {
+        build(c, &cbCompilerPlugin::Clean, &cbCompilerPlugin::Clean);
+    });
+    rexx->Add("RUN", "TARGET,WAIT/S", [build](wxARexxCommand& c) {
+        build(c, &cbCompilerPlugin::Run, &cbCompilerPlugin::Run);
+    });
+    rexx->Add("STOP", "", [compiler](wxARexxCommand& c) {
+        if (cbCompilerPlugin* cp = compiler(c))
+            cp->KillProcess();
+    });
+    rexx->Add("BUSY", "", [compiler](wxARexxCommand& c) {
+        if (cbCompilerPlugin* cp = compiler(c))
+            c.SetResult(cp->IsRunning() ? "1" : "0");
+    });
+    rexx->Open();
+    frame->Bind(wxEVT_DESTROY, [frame, rexx](wxWindowDestroyEvent& ev) {
+        if (ev.GetEventObject() == frame)
+            delete rexx;
+        ev.Skip();
+    });
+}
+#endif

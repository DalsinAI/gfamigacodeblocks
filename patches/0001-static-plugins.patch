+namespace
+{
+    struct StaticPlugin
+    {
+        wxString name;
+        const char* file;
+        CreatePluginProc createProc;
+        FreePluginProc freeProc;
+        PluginSDKVersionProc versionProc;
+    };
+    // a function's static, so it exists before any registrant runs
+    std::vector<StaticPlugin>& StaticPlugins()
+    {
+        static std::vector<StaticPlugin> plugins;
+        return plugins;
+    }
+    bool s_StaticPluginsLoaded = false;
+}
+
+void cbAddStaticPlugin(const wxString& name, const char* file,
+                       CreatePluginProc createProc,
+                       FreePluginProc freeProc,
+                       PluginSDKVersionProc versionProc)
+{
+    StaticPlugin sp = { name, file, createProc, freeProc, versionProc };
+    StaticPlugins().push_back(sp);
+}
+
 int PluginManager::ScanForPlugins(const wxString& path)
 {
+    // the plugins linked into the program, once, as LoadPlugin() does for
+    // one that a library brings; their resources are found as a library's
+    // are, by the file name
+    int staticCount = 0;
+    if (!s_StaticPluginsLoaded)
+    {
+        s_StaticPluginsLoaded = true;
+        bool batchOnly = Manager::IsBatchBuild();
+        wxArrayString bbplugins;
+        if (batchOnly)
+            bbplugins = cbReadBatchBuildPlugins();
+        for (const StaticPlugin& sp : StaticPlugins())
+        {
+            const wxString file = wxString("lib") + wxString::FromUTF8(sp.file) + ".so";
+            if (batchOnly && bbplugins.Index(file) == wxNOT_FOUND)
+                continue;
+            m_RegisteredPlugins.clear();
+            m_pCurrentlyLoadingManifestDoc = nullptr;
+            m_CurrentlyLoadingFilename = file;
+            m_pCurrentlyLoadingLib = nullptr;
+            RegisterPlugin(sp.name, sp.createProc, sp.freeProc, sp.versionProc);
+            for (PluginRegistration& pr : m_RegisteredPlugins)
+            {
+                cbPlugin* plug = nullptr;
+                try
+                {
+                    plug = pr.createProc();
+                }
+                catch (cbException& exception)
+                {
+                    exception.ShowErrorMessage(false);
+                    continue;
+                }
+                PluginElement* plugElem = new PluginElement;
+                plugElem->fileName = file;
+                plugElem->info = pr.info;
+                plugElem->library = nullptr;
+                plugElem->freeProc = pr.freeProc;
+                plugElem->plugin = plug;
+                m_Plugins.Add(plugElem);
+                if (plug->GetType() == ptCompiler)
+                    m_CompilerPlugins.push_back(static_cast<cbCompilerPlugin*>(plug));
+                SetupLocaleDomain(pr.name);
+                ++staticCount;
+            }
+            m_RegisteredPlugins.clear();
+            delete m_pCurrentlyLoadingManifestDoc;
+            m_pCurrentlyLoadingManifestDoc = nullptr;
+            m_CurrentlyLoadingFilename.Clear();
+        }
+        Manager::Get()->GetLogManager()->Log(wxString::Format(_("Linked-in plugins: %d"), staticCount));
+    }
+
     static const wxString PluginsMask = platform::windows                      ? "*.dll"

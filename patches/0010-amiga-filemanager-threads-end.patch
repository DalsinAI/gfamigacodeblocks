AmigaOS: Code::Blocks ends when it quits. FileManager's three loader threads were never told to end (FileManager is never freed, and its Die() calls are commented out); the C library's exit waits for every thread still alive, so after QUIT the process stayed with its threads waiting on their semaphores. The threads are now on the heap (a detached wxThread deletes itself when it ends), ~FileManager tells them to end, and Manager::Shutdown frees FileManager after the other managers.

--- a/src/include/filemanager.h
+++ b/src/include/filemanager.h
@@ -111,9 +111,18 @@
 // ***** class: FileManager *****
 class DLLIMPORT FileManager : public Mgr<FileManager>
 {
+#ifdef __AMIGA__
+    // on the heap: a detached wxThread deletes itself when told to end, and
+    // these are told to end in ~FileManager (the C library's exit waits for
+    // every thread still alive, so threads left waiting kept the program open)
+    BackgroundThread *fileLoaderThread;
+    BackgroundThread *uncLoaderThread;
+    BackgroundThread *urlLoaderThread;
+#else
     BackgroundThread fileLoaderThread;
     BackgroundThread uncLoaderThread;
     BackgroundThread urlLoaderThread;
+#endif
 public:
     FileManager();
     ~FileManager() override;
--- a/src/sdk/filemanager.cpp
+++ b/src/sdk/filemanager.cpp
@@ -125,6 +125,22 @@
 }
 
 // ***** class: FileManager *****
+#ifdef __AMIGA__
+FileManager::FileManager()
+    : fileLoaderThread(new BackgroundThread(false)),
+    uncLoaderThread(new BackgroundThread(false)),
+    urlLoaderThread(new BackgroundThread(false))
+{
+}
+
+FileManager::~FileManager()
+{
+    // each ends its loop and deletes itself (detached)
+    fileLoaderThread->Die();
+    uncLoaderThread->Die();
+    urlLoaderThread->Die();
+}
+#else
 FileManager::FileManager()
     : fileLoaderThread(false),
     uncLoaderThread(false),
